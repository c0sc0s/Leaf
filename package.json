{
  "name": "leaf-reader",
  "version": "1.5.2",
  "description": "Leaf \u2014 a quiet space for your PDFs and Markdown books",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Leaf",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:plugins && npm run build:runtime && vite --host 127.0.0.1",
    "build:electron": "node scripts/build.ts electron",
    "desktop": "npm run build:electron && concurrently -k -n vite,electron \"npm:dev\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "npm run typecheck && node scripts/build.ts all && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "npm run build:electron && playwright test",
    "samples": "node scripts/samples.mjs",
    "icon": "node scripts/icon.mjs",
    "assets": "node scripts/assets.mjs",
    "postinstall": "npm run assets",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 -c.mac.identity=- --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 -c.win.signExecutable=false --publish never",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write src packages plugins electron scripts tests *.ts *.json *.html docs README.md",
    "format:check": "prettier --check src packages plugins electron scripts tests *.ts *.json *.html docs README.md",
    "check": "npm run check:architecture && npm run lint && npm run typecheck && npm run format:check && npm test",
    "test:desktop": "node tests/packaged/desktop.mjs",
    "test:production": "npm run build && node tests/packaged/production.mjs",
    "release": "node scripts/release.mjs",
    "dev:site": "npm --prefix site run dev",
    "build:site": "npm --prefix site run build",
    "preview:site": "npm --prefix site run preview",
    "build:plugins": "node scripts/build.ts plugins",
    "build:runtime": "node scripts/build.ts runtime",
    "check:architecture": "node scripts/check-boundaries.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:browser": "playwright test --project browser",
    "test:electron": "npm run build:electron && playwright test --project desktop",
    "catalog:build": "node scripts/catalog.ts",
    "catalog:publish": "node scripts/publish-catalog.mjs",
    "test:catalog": "node tests/packaged/catalog.mjs"
  },
  "build": {
    "appId": "app.leaf.reader",
    "productName": "Leaf",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "licenses/**/*",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-win-${arch}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Viewer"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown document",
        "role": "Viewer"
      }
    ],
    "extraResources": [
      {
        "from": "dist-plugins/leaf.pdf.leaf-plugin",
        "to": "bundled-plugins/leaf.pdf.leaf-plugin"
      }
    ]
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "loading-dev": "0.3.5",
    "motion": "^13.4.4",
    "oxlint": "1.86.0",
    "prettier": "^3.9.9",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ]
}
